# portals.trucksoft.com.ng resolves to the production host via the wildcard A
# record (portal.trucksoft.com.ng has its own record pointing elsewhere).
# To add it: back up the Caddyfile, `caddy validate`, and reload via the admin API
# on 127.0.0.1:2020 — never Restart-Service (PayFlow, CMSv6, Forms share it).
portals.trucksoft.com.ng {
	encode gzip zstd
	reverse_proxy 127.0.0.1:8040
}
