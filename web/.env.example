DATABASE_URL="postgresql://portal:portal@127.0.0.1:5545/trucksoft_portal?schema=public"
PORTAL_JWT_SECRET="change-me-to-a-long-random-string-at-least-32-chars"
VAULT_MASTER_KEY="change-me-to-another-long-secret-at-least-32-chars"
ZOHO_CLIENT_ID=""
ZOHO_CLIENT_SECRET=""
ZOHO_REDIRECT_URI="http://localhost:3000/api/auth/zoho/callback"
ZOHO_ACCOUNTS_URL="https://accounts.zoho.com"
# Public origin for server-side redirects (read at runtime; no rebuild to change it)
APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Local only: allow /login/dev without Zoho
ALLOW_DEV_LOGIN="0"
# One-click demo views (seeded demo.* personas): no vault, never admin. Safe to
# enable on a public host — tiles only link out; each app keeps its own login.
DEMO_LOGIN="0"
# Username + PIN without the Zoho gate (lockout still applies). Interim until
# ZOHO_CLIENT_ID/SECRET are set; once they are, the sign-in page uses Zoho.
PIN_ONLY_LOGIN="0"
