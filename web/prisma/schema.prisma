generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Department {
  OPERATIONS
  MAINTENANCE
  FINANCE
  HR
  IT
  TELEMATICS
}

model User {
  id                 String       @id @default(cuid())
  username           String       @unique
  displayName        String
  pinHash            String
  departments        Department[]
  allowedZohoEmails  String[]
  isAdmin            Boolean      @default(false)
  disabledAt         DateTime?
  failedPinAttempts  Int          @default(0)
  lockedUntil        DateTime?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  vaultEntries VaultEntry[] @relation("OwnerVault")
  audits       AuditLog[]
}

model AppCatalog {
  id          String       @id @default(cuid())
  name        String
  url         String
  description String?
  departments Department[]
  external    Boolean      @default(false)
  sortOrder   Int          @default(0)
  active      Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model VaultEntry {
  id               String       @id @default(cuid())
  title            String
  url              String?
  usernameHint     String?
  /// AES-256-GCM ciphertext (base64): iv + tag + payload, envelope-encrypted
  secretCiphertext String
  scope            String       // PRIVATE | DEPARTMENT
  ownerId          String?
  owner            User?        @relation("OwnerVault", fields: [ownerId], references: [id])
  department       Department?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([ownerId])
  @@index([department])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  username  String
  action    String
  meta      Json?
  createdAt DateTime @default(now())

  @@index([username])
  @@index([createdAt])
}

model ZohoGateSession {
  id        String   @id @default(cuid())
  zohoEmail String
  zohoSub   String?
  expiresAt DateTime
  createdAt DateTime @default(now())
}
